# Keep PostgreSQL as a Dockerfile dependency so Dependabot can update both the
# human-readable tag and the immutable manifest digest.
FROM postgres:18.6-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873

ARG THORNHILL_REVISION=unknown
ARG THORNHILL_SOURCE=https://github.com/qiviut/thornhill

LABEL org.opencontainers.image.title="Thornhill PostgreSQL" \
      org.opencontainers.image.description="Pinned PostgreSQL runtime for Thornhill" \
      org.opencontainers.image.source="${THORNHILL_SOURCE}" \
      org.opencontainers.image.revision="${THORNHILL_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

# The upstream point-release image is not rebuilt for every Alpine advisory.
# Apply current repository security fixes, then gate the resulting image with
# Trivy. The pinned base digest still makes the upstream starting point clear.
RUN apk upgrade --no-cache
